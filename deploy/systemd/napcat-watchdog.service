[Unit]
Description=Dice-Bot NapCat QQ Login Watchdog
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/Dice-Bot
EnvironmentFile=/home/ubuntu/apps/Dice-Bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/apps/Dice-Bot/.venv/bin/python -m src.napcat_watchdog
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
